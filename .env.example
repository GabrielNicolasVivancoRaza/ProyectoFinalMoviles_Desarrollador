# Configuración del servidor
PORT=3000

# MongoDB - Usa MongoDB Atlas para producción
# Crea una base de datos gratis en: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb://localhost:27017/vivanco_turismo

# Secret para sesiones (cambia esto en producción)
SESSION_SECRET=vivanco-turismo-secret-key-change-this

# Entorno (development o production)
NODE_ENV=development
